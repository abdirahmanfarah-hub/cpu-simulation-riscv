.data
enterMsg1: .string "Please use the last 4 digits of your student id as two 2-digit numbers \n"
enterMsg2: .string "Please enter your first set of digits now \n"
enterMsg3: .string "Enter your next number now \n"
totalMsg:  .string "The total is "
OrMsg:     .string "\nor value is "
NotMsg:    .string "\n Not value is "
AndMsg:    .string "And value is "
nlMsg:     .string "\n"

.text

###
# output the first instruction text to the console
addi a7, zero, 4
la a0, enterMsg1
ecall

# output the second instruction text to the console
addi a7, zero, 4
la a0, enterMsg2
ecall

# read an integer from keyboard input and store in s0
addi a7, zero, 5
ecall
add s0, zero, a0

# output the text asking for the next number to the console
# then receive the input and store in s1
addi a7, zero, 4
la a0, enterMsg3
ecall

addi a7, zero, 5
ecall
add s1, zero, a0

## add the two values together and store in s2
add s2, s0, s1

or  s3, s0, s1
and t0, s0, s1
not s4, t0

##output the total
la  a0, totalMsg
add a1, s2, zero
jal printMsgInt

# Output message and value for bitwise OR
la  a0, OrMsg
add a1, s3, zero
jal printMsgInt

# Output message and value for bitwise NAND
la  a0, NotMsg
add a1, s4, zero
jal printMsgInt

addi a7, zero, 10
ecall


# ---------------- subroutine ----------------
# a0 = address of message
# a1 = integer value
printMsgInt:
    addi a7, zero, 4       # print string
    ecall

    add  a0, a1, zero      # move value into a0 for print int
    addi a7, zero, 1       # print int
    ecall

    addi a7, zero, 4       # print newline
    la   a0, nlMsg
    ecall

    ret
